generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  tier          String    @default("free")
  tokensUsed    Int       @default(0)
  tokenLimit    Int       @default(10000)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents     Document[]
  conversations Conversation[]
  usageLogs     UsageLog[]
  refreshTokens RefreshToken[]
  roles         UserRole[]

}


model Document {
  id            String   @id @default(uuid())
  userId        String
  title         String
  filename      String
  content       String
  mimeType      String?
  fileSizeBytes Int?
  chunkCount    Int      @default(0)
  status        String   @default("pending")
  error         String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        Chunk[]
  messages      Message[]
  conversations Conversation[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model Chunk {
  id          String   @id @default(uuid())
  documentId  String
  index       Int
  content     String
  tokenCount  Int
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@unique([documentId, index])
}

model Conversation {
  id         String    @id @default(uuid())
  userId     String
  documentId String?
  title      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([userId])
  @@index([documentId])
}


model Message {
  id               String       @id @default(uuid())
  conversationId   String
  documentId       String?
  role             String       // "user" or "assistant"
  content          String
  sources          String?      // JSON: chunk IDs used as context
  confidence       String?      // "high", "medium", "low"
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?
  latencyMs        Int?
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([documentId])
}

model UsageLog {
  id           String   @id @default(uuid())
  userId       String
  action       String   // "embed", "chat", "upload", "document_created", etc.
  tokens       Int      @default(0)
  costUsd      Float    @default(0)
  resourceId   String?  // ID of the related resource
  resourceType String?  // "document", "conversation", etc.
  metadata     String?  // JSON
  createdAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AITrace {
  id        String   @id @default(uuid())
  traceId   String   @unique
  userId    String?
  operation String
  data      String   // JSON
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([operation])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Blacklist access tokens on logout for immediate invalidation
model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Webhook idempotency — prevents duplicate processing of the same event
model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique // Unique identifier from webhook provider
  eventType   String             // Type of webhook event
  payload     String             // JSON string (SQLite doesn't support Json)
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Audit log for document access actions
model AccessLog {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  action     String
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  @@index([userId])
  @@index([documentId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique   // 'admin', 'member', 'viewer'
  description String?
  isDefault   Boolean  @default(false)  // New users get this role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique   // 'documents:create'
  description String?
  resource    String              // 'documents'
  action      String              // 'create'
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?  // Who assigned this role (for audit)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}
